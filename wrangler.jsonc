// Cloudflare deploys the built site (dist/) as static assets. Its GitHub
// integration runs `pnpm build`, then `npx wrangler deploy`, on every push.
{
  "name": "treechat",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
