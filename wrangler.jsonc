// Cloudflare deploys the built site (dist/) as static assets. Its GitHub
// integration runs `pnpm build`, then `npx wrangler deploy`, on every push.
{
  "name": "treechat",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Branch and pull-request builds run `npx wrangler preview`, which needs this
  // block; empty is enough, everything else stays at the top level.
  "previews": {},
}
