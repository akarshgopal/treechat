# Production BYOK is client-side: paste an OpenRouter key in Settings.
# It lives in this browser's localStorage and is sent from the page to OpenRouter.
# These env vars are optional local fallbacks for `pnpm dev` / `pnpm preview`.
# Leave them blank to use the polished mock stream.
# Do not prefix provider keys with VITE_ — keys must not ship in the browser bundle.

# SpaceXAI / xAI. OpenAI-compatible at https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.6

# OpenAI — used if XAI_API_KEY is unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter — used if neither xAI nor OpenAI is set
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Public path. Local default is /. GitHub Actions sets /treechat/ from GITHUB_REPOSITORY.
# VITE_BASE=/treechat/
