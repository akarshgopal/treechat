# TreeChat keeps keys on the server. Leave all blank to use polished mock streaming.

# SpaceXAI / xAI (preferred). OpenAI-compatible at https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.6

# OpenAI — used if XAI_API_KEY is unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter — used if neither xAI nor OpenAI is set
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
